{
  "name": "dsh-context-window",
  "version": "0.4.3",
  "private": true,
  "description": "输入框下方那个「白圈」点开后的弹层：官方占用投影 + 宿主分类（MCP 工具平铺 server · tool 明细 / 系统工具 / 技能）",
  "license": "MIT",
  "type": "module",
  "main": "lib/host.v5.js",
  "scripts": {
    "test": "node tools/host-test.mjs && node tools/route-test.mjs && node tools/client-test.mjs",
    "test:route": "node tools/route-test.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/host.v5.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./classify": {
      "default": "./lib/classify.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/host.v5.js",
    "lib/classify.js",
    "lib/estimate.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
