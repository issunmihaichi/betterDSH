{
  "name": "dsh-usage-report",
  "version": "0.1.0",
  "private": true,
  "description": "设置里的「用量」页：按天统计本机会话的输入/输出 token（纯本地，无网络请求、无计费数据）",
  "license": "MIT",
  "type": "module",
  "main": "lib/host.js",
  "scripts": {
    "test": "node tools/report-test.mjs && node tools/host-test.mjs && node tools/client-test.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/host.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./report": {
      "default": "./lib/report.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/host.js",
    "lib/client.js",
    "lib/report.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
