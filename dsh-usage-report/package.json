{
  "name": "dsh-usage-report",
  "version": "0.2.1",
  "private": true,
  "description": "本机用量统计：Token、聊天排行、工具/技能活动和模型消息趋势（纯本地，无计费数据）",
  "license": "MIT",
  "type": "module",
  "main": "lib/host.js",
  "scripts": {
    "test": "node tools/report-test.mjs --synthetic-only && node tools/host-test.mjs && node tools/client-test.mjs",
    "test:local": "node tools/report-test.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/host.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./report": {
      "default": "./lib/report.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/host.js",
    "lib/client.js",
    "lib/report.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
