{
  "name": "dsh-mcp-skills",
  "version": "0.1.1",
  "private": true,
  "description": "设置里的「MCP 与技能」页：统一管理 MCP 服务器（启停、配置、工具数）与技能库（列表、查看、模型调用开关）",
  "license": "MIT",
  "type": "module",
  "main": "lib/host.js",
  "scripts": {
    "test": "node tools/host-test.mjs && node tools/client-test.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/host.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/host.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "lib/estimate.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
