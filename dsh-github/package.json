{
  "name": "dsh-github",
  "version": "0.1.3",
  "private": true,
  "description": "GitHub support: a GitHub management page in Settings, the /github human command for GitHub MCP tools, and remote repository cloning into a workspace",
  "license": "MIT",
  "type": "module",
  "main": "lib/host.js",
  "icon": "./icon.svg",
  "scripts": {
    "test": "node tools/pure-test.mjs && node tools/host-test.mjs && node tools/lifecycle-test.mjs && node tools/client-test.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/host.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./mcpconfig": {
      "default": "./lib/mcpconfig.js"
    },
    "./commands": {
      "default": "./lib/commands.js"
    },
    "./remote": {
      "default": "./lib/remote.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/host.js",
    "lib/client.js",
    "lib/mcpconfig.js",
    "lib/commands.js",
    "lib/remote.js",
    "lib/settings.js",
    "lib/git.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
