    "lib/runtime-v0.4.48-local-tauri",
    "lib/runtime-v0.4.49-local-tauri",
    "LOCAL-API.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "zod": "^4.6.5",
    "ws": "^8.18.3"
  },
  "scripts": {
    "test": "node tools/test.mjs",
    "test:retry": "node --test tools/retry-test.mjs",
    "test:continuity": "node --test tools/codex-continuity-test.mjs tools/codex-test.mjs",
    "test:codex-ws": "node --test tools/codex-websocket-test.mjs tools/codex-websocket-integration-test.mjs",
    "test:codex-compaction": "node --test tools/codex-compaction-test.mjs tools/codex-compaction-host-test.mjs",
    "test:attribution": "node tools/test.mjs attribution",
    "test:model-probe": "node tools/test.mjs model-probe",
