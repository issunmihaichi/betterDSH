{
  "name": "dsh-account-pool",
  "version": "0.4.26",
  "private": true,
  "description": "DSH 账号池：两层选路（粘性会话 + 负载感知）、失败冷却与降级（对标 sub2api 号池核心，自用规模）",
  "license": "MIT",
  "type": "module",
  "main": "./lib/runtime-v0.4.49-local-tauri/host.js",
  "exports": {
    ".": {
      "default": "./lib/runtime-v0.4.49-local-tauri/host.js"
    },
    "./kernel": {
      "default": "./lib/kernel.js"
    },
    "./adapter": {
      "default": "./lib/adapter.js"
    },
    "./domain": {
      "default": "./lib/domain.js"
    },
    "./upstream": {
      "default": "./lib/upstream.js"
    },
    "./oauth": {
      "default": "./lib/oauth.js"
    },
    "./claude-code": {
      "default": "./lib/claude-code/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib/host.js",
    "lib/client.js",
    "lib/kernel.js",
    "lib/adapter.js",
    "lib/usage-timing.js",
    "lib/codex-compaction-bridge.js",
    "lib/domain.js",
    "lib/upstream.js",
    "lib/detection.js",
    "lib/retry.js",
    "lib/native",
    "lib/quota.js",
    "lib/reset-credits.js",
    "lib/supplier.js",
    "lib/group-models.js",
    "lib/importer.js",
    "lib/oauth.js",
    "lib/oauth",
    "lib/claude-code",
    "cordis.patch.yml",
    "DESIGN.md",
    "README.md",
    "lib/codex-speed.js",
    "lib/runtime-v0.4.43-batch-attribution",
    "lib/runtime-v0.4.44-per-preset-compaction",
    "lib/runtime-v0.4.46-local-api",
    "lib/local-api.js",
    "lib/local-api-protocol.js",
    "lib/local-api-controller.js",
    "lib/local-api-responses-request.js",
    "lib/local-api-responses-output.js",
